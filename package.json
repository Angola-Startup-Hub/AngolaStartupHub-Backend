{
  "name": "angola-startup-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file=.env.local --env-file=.env src/dev.js",
    "hash": "node src/hash.js",
    "postinstall": "prisma generate",
    "db:push": "node --env-file=.env.local node_modules/prisma/build/index.js db push",
    "db:migrate": "node --env-file=.env.local node_modules/prisma/build/index.js migrate dev",
    "db:deploy": "node --env-file=.env.local node_modules/prisma/build/index.js migrate deploy",
    "db:studio": "node --env-file=.env.local node_modules/prisma/build/index.js studio",
    "build": "prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1162.0",
    "@aws-sdk/s3-request-presigner": "^3.1162.0",
    "@neon/config": "^1.11.3",
    "@neon/env": "^1.6.15",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "prisma": "^6.19.3"
  }
}