# As variáveis do Neon (DATABASE_URL, DATABASE_URL_UNPOOLED, AWS_*) vêm do `neon deploy` para .env.local
# Aqui ficam só as da app (ficheiro .env):
JWT_SECRET=muda-isto
# Gera o hash com: npm run hash -- "a-tua-password"
ADMIN_EMAIL=admin@angolastartup.com
ADMIN_PASSWORD_HASH=
ADMIN_NAME=Jorge Barros
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Bucket para uploads (news ou assets)
S3_BUCKET=news
# Opcional: URL de uma CDN/proxy à frente do bucket. Vazio = URL público do bucket Neon
S3_PUBLIC_URL=
